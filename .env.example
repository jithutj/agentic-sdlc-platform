# Copy to .env; generate two DIFFERENT local-only passwords before starting.
# Blank values deliberately fail Compose validation. Never use real service credentials.
POSTGRES_DB=agentic_sdlc
API_PORT=8000
POSTGRES_PASSWORD=
DB_PASSWORD=
# Compose sets DB_HOST=db, DB_PORT=5432 and DB_USER=sdlc_app for the API.
# Compose also sets WORKFLOW_PERSISTENCE=postgres and runs a separate admin migration.
# Python-only previews default to WORKFLOW_PERSISTENCE=memory and are not durable.
# Host Python does not load .env automatically or reach the private Compose database.
