# Copy to .env; generate three DIFFERENT local-only passwords before starting.
# Blank secrets deliberately fail Compose validation. Use local-only secrets.
# The optional live pilot permits only scoped development read-only Linear keys.
POSTGRES_DB=agentic_sdlc
API_PORT=8000
POSTGRES_PASSWORD=
DB_PASSWORD=
# Use three DIFFERENT passwords. WINDMILL_DB_PASSWORD must be URL-safe hex.
WINDMILL_DB_PASSWORD=
WINDMILL_PORT=8001
# Generate a separate local intake token (at least 32 characters).
PILOT_INTAKE_TOKEN=
# Leave these blank for infrastructure-only startup. Intake fails closed.
# Use a narrowly scoped read-only key; never use production credentials.
LINEAR_READ_API_KEY=
PILOT_LINEAR_WORKSPACE_ID=
PILOT_LINEAR_TEAM_ID=
PILOT_LINEAR_PROJECT_ID=
PILOT_LINEAR_ISSUE_UUID=
# Compose sets DB_HOST=db, DB_PORT=5432 and DB_USER=sdlc_app for the API.
# Compose also sets WORKFLOW_PERSISTENCE=postgres and runs a separate admin migration.
# Python-only previews default to WORKFLOW_PERSISTENCE=memory and are not durable.
# Host Python does not load .env automatically or reach the private Compose database.

# Mock only; real providers and credentials are not supported.
LLM_PROVIDER=mock
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_OUTPUT_BYTES=12000
LLM_MAX_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=1
LLM_RUN_TIMEOUT_SECONDS=3
LLM_RUN_BUDGET_UNITS=60000
